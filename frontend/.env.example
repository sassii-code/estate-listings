# ==========================================
# MAA DURGA PROPERTIES Frontend Environment Variables
# ==========================================
# Copy this file to .env and update values for your environment.

# Backend API base URL (without trailing /api)
# Local development:
VITE_API_BASE_URL=http://localhost:4000
# Production example:
# VITE_API_BASE_URL=https://real-estate-website-backend-zfu7.onrender.com

# Business contact details used across the site (optional except for call actions)
VITE_BUSINESS_PHONE=+91XXXXXXXXXX
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX
VITE_BUSINESS_ADDRESS=
VITE_BUSINESS_EMAIL=
VITE_BUSINESS_OWNER_NAME=
VITE_YEARS_IN_HARIDWAR=
